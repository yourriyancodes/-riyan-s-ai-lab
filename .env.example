# ─────────────────────────────────────────────────────────────────────────────
# RAVEN brain — environment
#
# Every variable here is OPTIONAL. With an empty file the brain still runs: the
# knowledge layer, the intent classifier, the tool registry, the state machine and
# file-backed memory all work with no account, no key and no database. Setting a
# variable adds a capability; leaving it out never breaks anything.
#
# Copy to .env.local (git-ignored) and fill in only what you actually want.
# ─────────────────────────────────────────────────────────────────────────────

# ── Generative provider (optional) ──────────────────────────────────────────
# Google AI Studio "Developer API" key. With no key, /api/raven answers from local
# knowledge and says so; it never pretends a model ran.
RAVEN_API_KEY=
# 'gemini' | 'openai' (any OpenAI-compatible server) | 'none' to force it off.
# Inferred from RAVEN_BASE_URL when left blank.
RAVEN_PROVIDER=
# Required unless the provider implies a default.
#   gemini → gemini-2.5-flash      openai → llama3.1
RAVEN_MODEL=
# Override for a proxy or a local server. Defaults:
#   gemini → https://generativelanguage.googleapis.com
#   openai → http://127.0.0.1:11434/v1   (Ollama; LM Studio uses :1234/v1)
RAVEN_BASE_URL=
# Some local servers reject response_format={"type":"json_object"}; set 0 to stop sending it.
RAVEN_PROVIDER_JSON=1
# 0–2. Lower is more factual; this backend asks for grounded answers, not creativity.
RAVEN_TEMPERATURE=0.35
# Hard cap per provider round-trip. A timeout degrades to the local answer, it does not hang.
RAVEN_TIMEOUT_MS=25000
# Retries for transient statuses only (408/425/429/5xx), exponential backoff. Max 3.
RAVEN_MAX_RETRIES=2
RAVEN_MAX_OUTPUT_TOKENS=1024

# Where /api/health looks for a local model it was NOT configured to use, so it can tell you one
# exists. Detection only reports; it never routes. 0 means "answer nothing about local servers".
RAVEN_LOCAL_PROBE_URL=http://127.0.0.1:11434/v1

# ₹0 local GenAI (no key, no bill) — start Ollama, pull a model, then two lines and nothing else:
#   RAVEN_BASE_URL=http://127.0.0.1:11434/v1
#   RAVEN_MODEL=llama3.1
# RAVEN_PROVIDER is inferred from the base URL and a server that authenticates nothing needs no key.
# /api/health then reports provider.usable:true beside provider.configured:false — the honest pair,
# since "an endpoint is configured" and "a credential exists" are different sentences. (Setting
# RAVEN_PROVIDER=openai explicitly still works; before this round the base URL alone silently
# selected nothing, which is the bug those two flags now make impossible to hide.)
# Leave RAVEN_API_KEY empty.

# ── Model-assisted planning (optional, OFF by default) ───────────────────────
# 1 lets the agent ask the model for next steps before falling back to its deterministic
# gap rules. Every proposal is validated server-side against the tool registry: registered
# name → arguments checked against the tool's own spec → no mutating ('action') tool →
# deduped → capped. Nothing the model writes is executed, and a rejected proposal is
# reported in the trace (metadata.trace 'model-plan') rather than silently dropped.
# Off by default because the deterministic planner is free, instant and predictable.
RAVEN_MODEL_PLANNING=

# ── Circuit breaker ─────────────────────────────────────────────────────────
# Consecutive provider failures before /api/raven stops calling the model and answers from
# local evidence. Cooldown is how long it stays open. Both are reported by /api/health,
# including `failures` while the breaker is still closed. Cancellation is not a failure:
# a client that navigates away does not count toward the threshold.
RAVEN_BREAKER_THRESHOLD=2
RAVEN_BREAKER_COOLDOWN_MS=60000

# ── Free-tier endpoints (research, verify before relying on them) ────────────
# These were gathered from secondary sources in Nov 2026 because vendor documentation was
# unreachable from the build environment. Nothing here was installed, subscribed to or paid
# for, and no free tier was exercised — confirm the current terms before trusting a number.
#   Groq        RAVEN_PROVIDER=openai  RAVEN_BASE_URL=https://api.groq.com/openai/v1
#               free plan, no card; ~30 RPM / 1,000 requests per day / 8,000 tokens per
#               minute, applied per model (gpt-oss-20b, gpt-oss-120b).
#   OpenRouter  RAVEN_PROVIDER=openai  RAVEN_BASE_URL=https://openrouter.ai/api/v1
#               ':free' model ids; ~20 RPM and 50 requests per day. Free providers may log
#               prompts — do not send anything private through one.
#   Mistral     RAVEN_PROVIDER=openai  RAVEN_BASE_URL=https://api.mistral.ai/v1
#               free "Experiment" tier ~1B tokens/month, ~1 req/s; phone verification and
#               opt-in to training are part of it.
#   Gemini      RAVEN_PROVIDER=gemini  (default base URL)
#               a free tier exists but Google no longer publishes per-model numbers; since
#               2026-04-01 Pro models are paid-only and Flash/Flash-Lite carry the free
#               tier. Free-tier data may be used for training.
#   GitHub Models — RETIRED 2026-07-30. The inference endpoint returns 410; tutorials
#               pointing at models.github.ai/inference no longer work.
#   Cerebras    free tier replaced 2026-07-16 by a $5 card-required trial — not free.
# A refused credential is reported distinctly from a missing one: /api/health answers
# provider.probed.authorized=false with the note that the endpoint answered but rejected
# the key, so a typo is not mistaken for an outage.

# ── Persistence (optional) ──────────────────────────────────────────────────
# Postgres: self-hosted, Neon, Supabase, or a local container.
# Without "pg" installed this is skipped with a written reason (see below).
DATABASE_URL=
# Alternative name some hosts provide; either one is accepted.
SUPABASE_DB_URL=
# Supabase REST (PostgREST) transport — no dependency, no TCP pool, works serverless.
# Apply db/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_DB_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Force a driver: 'postgres' | 'postgres-rest' | 'sqlite' | 'file' | 'memory'.
# Default order when unset: postgres (if DATABASE_URL) → postgres-rest (if Supabase
# vars) → sqlite (if RAVEN_SQLITE_PATH) → file → memory. A candidate that fails is
# recorded in metadata and skipped, so /api/health can say which one is actually in use.
RAVEN_DB_DRIVER=
# A real local database with no dependency and no server: the SQLite driver uses the
# `node:sqlite` module Node ships (Node 22.5+). It is opt-in, not the default, because
# that module is still experimental — set a path and you get transactions, foreign keys
# and durable rows in one file; leave it empty and the JSON file store below stays in use.
# The schema is not a second copy: it is generated from db/schema.sql, so the two engines
# cannot drift. If the runtime has no node:sqlite, the brain says so and continues on file.
#   RAVEN_DB_DRIVER=sqlite RAVEN_SQLITE_PATH=.raven-data/brain.db  npm run dev
RAVEN_SQLITE_PATH=
# Where the file store keeps its JSON. Committed? No — .raven-data/ is git-ignored.
RAVEN_DATA_DIR=.raven-data
# Set 0 to disable disk writes entirely (then memory is the only fallback, and the
# console is told that persistence is ephemeral rather than being lied to).
RAVEN_ALLOW_FILE_STORE=1
# How long a Postgres handshake may take before the brain gives up on it.
RAVEN_DB_TIMEOUT_MS=5000

# To enable the postgres driver:  npm install pg
# It is deliberately NOT a dependency: an optional driver should not be installed or
# bundled for people who never configured a database.

# ── Sessions and limits ─────────────────────────────────────────────────────
# When set, the session id is issued as an HttpOnly cookie with an HMAC tag, so a
# forged id can be detected. When unset, the client's own id is used unverified —
# fine for a portfolio, not for anything private.
SESSION_SECRET=
RAVEN_SESSION_MAX_AGE=2592000

RAVEN_MAX_MESSAGE_CHARS=4000
RAVEN_MAX_BODY_BYTES=65536
# How many prior messages of this conversation go into the context.
RAVEN_MAX_HISTORY=40
# Character budget for everything sent to a provider (evidence + history + facts).
RAVEN_CONTEXT_CHAR_BUDGET=6000
RAVEN_MAX_MEMORIES=8
RAVEN_AGENT_MAX_STEPS=6
# Ceiling for ONE tool step, applied by the registry to every tool — including a tool that declares
# a longer one of its own. A step that exceeds it comes back status='timeout' and the turn continues.
RAVEN_AGENT_STEP_TIMEOUT_MS=8000
# Ceiling for the whole agentic turn. When it runs out the agent is abandoned rather than waited on:
# the turn answers from what retrieval had already returned and names the overrun in `degraded`.
# Both of these are enforced by the brain; they used to be read and ignored, which is worse than
# not documenting them.
RAVEN_AGENT_TURN_TIMEOUT_MS=30000
# Sliding-window rate limit per client, in-process. 429 + retry-after when exceeded.
RAVEN_RATE_WINDOW_MS=60000
RAVEN_RATE_MAX=30
RAVEN_MAX_QUERY_CHARS=400

# ── Voice (reserved) ────────────────────────────────────────────────────────
# Output speech runs in the browser via Web Speech API and needs no key. This is for a
# future hosted TTS/STT provider; reporting it configured does not make RAVEN sing.
VOICE_PROVIDER_KEY=

# ── Cost estimation only ────────────────────────────────────────────────────
# Used by the estimate_token_cost tool to render an INR figure. Not a bill.
RAVEN_USD_INR=84
