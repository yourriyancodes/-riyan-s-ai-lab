# ---------------------------------------------------------------------------
# RAVEN infrastructure
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- AI provider (Google Gemini, free tier) --------------------------------
# RAVEN_API_KEY is the canonical name; GEMINI_API_KEY is accepted as an alias.
# Get a key at https://aistudio.google.com/apikey (no credit card required).
RAVEN_API_KEY=
# GEMINI_API_KEY=

# Free-tier eligible models: gemini-2.5-flash (default), gemini-2.5-flash-lite,
# gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-flash-lite.
# Paid-only models (gemini-4-argon, Pro) will fail on a free-tier key.
RAVEN_MODEL=gemini-2.5-flash

# Optional overrides — the defaults below are correct for Google AI Studio.
# RAVEN_PROVIDER=gemini
# RAVEN_API_BASE_URL=https://generativelanguage.googleapis.com
# RAVEN_TIMEOUT_MS=20000

# --- Remaining infrastructure (optional, not used by the model call) --------
DATABASE_URL=
SESSION_SECRET=
VOICE_PROVIDER_KEY=
