{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:assets": "node scripts/check-assets.mjs",
    "gen:portrait": "node scripts/generate-portrait-depth.mjs",
    "typecheck": "tsc --noEmit",
    "check:speech": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-speech-sync.mjs",
    "check:voice": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-voice.mjs",
    "check:framing": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-portrait-framing.mjs",
    "check:machine": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/tsr.mjs scripts/check-machine-render.mjs",
    "check": "npm run typecheck && npm run schema:check && npm run check:assets && npm run check:speech && npm run check:voice && npm run check:framing && npm run check:machine && npm run check:brain && npm run check:backend",
    "preview:machine": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/tsr.mjs scripts/render-machine-preview.mjs",
    "check:brain": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/tsr.mjs scripts/check-brain.mjs",
    "check:backend": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/tsr.mjs scripts/check-backend.mjs",
    "schema": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/tsr.mjs scripts/sync-schema.mjs",
    "schema:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/tsr.mjs scripts/sync-schema.mjs --verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
